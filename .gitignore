# Secrets and local configuration
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
**/secrets/
**/serviceAccount*.json

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Node and generated frontend output
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local document storage (exam papers, syllabi, reports — never commit)
# Ignore contents but keep empty folder placeholders via .gitkeep
uploads/**
!uploads/.gitkeep
backend/uploads/**
!backend/uploads/.gitkeep

# Local databases and dumps
*.db
*.sqlite
*.sqlite3
*.sql.bak

# Logs and scratch
*.log
logs/
scratch/
backend/scratch/

# Editor and operating-system files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
