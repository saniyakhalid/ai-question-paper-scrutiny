# Backend environment reference. Copy into backend/.env and replace the JWT placeholder.
ENVIRONMENT=development
JWT_SECRET=replace-with-a-generated-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB is the live application's primary database.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=question_paper_scrutiny

# Set AI_PROVIDER=gemini and provide GEMINI_API_KEY to enable Gemini analysis.
# The offline default uses deterministic/keyword heuristics and is labeled in reports.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# The Vite development server proxies /api to localhost:8000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
